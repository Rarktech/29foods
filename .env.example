# ── Supabase (Project Settings > API) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server-only. NEVER expose to the browser bundle.

# Google OAuth is configured inside the Supabase dashboard (Authentication > Providers > Google)
# using a Google Cloud OAuth Client ID/Secret. No separate app env vars are needed for it.

# ── Telegram (one bot token per surface, from @BotFather) ──────────
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_RIDER_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=               # chat id the admin bot pings for new orders / EOD summary

# ── Flutterwave (Dashboard > Settings > API) ────────────────────────
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=             # secret hash set in the FLW dashboard; verified against the `verif-hash` header

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
CRON_SECRET=                          # shared secret so /api/cron/* endpoints can't be hit by randoms
